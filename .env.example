# ==============================================================================
# CẤU HÌNH THÔNG TIN CHO TCF CANADA EDMONTON SLOT MONITOR
# Hãy copy file này thành .env và điền các giá trị thực tế của bạn
# (File .env đã được cấu hình trong .gitignore, không bị lộ lên GitHub)
# ==============================================================================

# 1. Đường link trang đăng ký thi TCF của Alliance Française Edmonton
TARGET_URL=https://edmonton.afedmonton.ca/community/event-rsvp/?event_id=YOUR_EVENT_ID

# 2. Token bot Telegram (Nhắn tin /newbot với @BotFather để nhận token)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 3. Chat ID nhận tin nhắn (Nhắn tin bất kỳ với @userinfobot để lấy số Id)
TELEGRAM_CHAT_ID=your_chat_id_here

# 4. Phạm vi ngày thi cần quét (Định dạng YYYY-MM-DD)
START_DATE=2026-11-23
END_DATE=2026-12-15
